# RecoverAI Environment Configuration

# Database Configuration (PostgreSQL primary, SQLite fallback for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai
# SQLite Fallback: sqlite:///./recoverai.db

# Demo / Simulation Mode (Set to true to prevent real transactions and safely simulate API calls)
DEMO_MODE=true

# Razorpay Test Mode Credentials (Get these from Razorpay Dashboard in Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# AI / LLM Configuration
LLM_PROVIDER=gemini  # gemini, openai, or mock
LLM_API_KEY=your_gemini_or_openai_api_key_here

# Policy Engine Configurations
MAX_AUTO_RETRY=1
MAX_AUTO_RECOVERY_AMOUNT=5000.0
MIN_AI_CONFIDENCE=0.80
